# QQ Bot 通知配置（复制到 ~/.config/tiyu/notify.env 并填入实际值）
#
# QQ 开放平台机器人：https://q.qq.com/
# QQ_TARGET 格式：qqbot:<openid>（openid 是机器人收到的用户 ID，不是 QQ 号）
QQ_APP_ID=YOUR_APP_ID
QQ_CLIENT_SECRET=YOUR_CLIENT_SECRET
QQ_TARGET=qqbot:YOUR_OPENID

# 可选
# HERMES_BIN=$HOME/.local/bin/hermes
# ADB_SERIAL=192.168.240.112:5555
